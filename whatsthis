#!/usr/bin/env bash
#
# whatsthis — nmap recon automator
# Author: Giva (github.com/Givaa)
#
# Phases: quick (top 1000) -> full TCP (-p- -sS) -> version+NSE (-sCV) -> UDP top 100 (-sUVC)
#
# Modes:
#   sequential (default) — single stream, nmap output on screen
#   parallel (-P)        — ports split into concurrent chunks + UDP alongside;
#                          jobs auto-detected from cores (cap 8) or set with -j N
#
# Anti-loss: -Pn (don't skip ping-blocking hosts); each scan must reach
#   "Nmap done" or it's retried; unconfirmed ranges are listed and exit != 0.
#
# Hostnames: always discovered from services and printed. With -H, whatsthis
#   also edits /etc/hosts (missing aliases) and renames the dir to
#   <name>-<discovered>. Off by default so scans never block on a prompt.
#   -H asks first; add -g to do it without asking.
#
# Options:
#   -P/-S    parallel / sequential (default: sequential)
#   -j N     parallel jobs (implies -P; 0 = auto)
#   -r       resume: skip scans already done
#   -H       enable /etc/hosts edits + dir rename (off by default)
#   -g       grant: do every op without asking (use with -H)
#   -f FILE  multi-target: one "IP [name]" per line (# = comment)
#   -v       verbose: print launched commands
#
# Usage: ./whatsthis [-v] [-P|-S] [-j N] [-r] [-H] [-g] <IP> [name]
#        ./whatsthis [opts] -f targets.txt
#
# Output dir ./<name>/: quick.txt allports.txt deep.txt udp.txt
#                       next-steps.txt summary.md
#
set -uo pipefail

# --- Colors ---
RED=$'\e[31m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; BLUE=$'\e[34m'; CYAN=$'\e[36m'; BOLD=$'\e[1m'; RST=$'\e[0m'
WHITE=$'\e[97m'; BLACK=$'\e[30m'

# Banner color from terminal background: dark shell -> white, light -> black.
# Detected via COLORFGBG ("fg;bg"); assumes dark when unavailable.
banner_color() {
    local bg
    case "${COLORFGBG:-}" in
        *';'*) bg="${COLORFGBG##*;}" ;;
        *)     bg="" ;;
    esac
    case "$bg" in
        7|9|1[0-5]) printf '%s' "$BLACK" ;;
        *)          printf '%s' "$WHITE" ;;
    esac
}

err()  { printf '%s[!]%s %s\n' "$RED"   "$RST" "$*" >&2; }
info() { printf '%s[*]%s %s\n' "$BLUE"  "$RST" "$*"; }
ok()   { printf '%s[+]%s %s\n' "$GREEN" "$RST" "$*"; }
warn() { printf '%s[!]%s %s\n' "$YELLOW" "$RST" "$*" >&2; }

VERBOSE=0
MODE="seq"        # seq | par
JOBS=0            # 0 = auto
RESUME=0
GRANT=0
HOSTS=0           # 1 = allow /etc/hosts edits + dir rename (-H); off by default
TARGETFILE=""
INCOMPLETE=0      # per-target
UNVERIFIED=()     # per-target
OVERALL_FAIL=0
MAX_TRIES=3
CHUNK_PIDS=(); CHUNK_FILES=(); CHUNK_RANGES=()
CMDLOG=""         # file logging the nmap commands (for summary)

# Log a launched command (appended to file; works from background subshells).
log_cmd() { [[ -n "$CMDLOG" ]] && printf '%s\n' "$*" >> "$CMDLOG"; }

# Run a command; print it first in verbose mode.
run() {
    (( VERBOSE )) && printf '%s[>]%s %s%s%s\n' "$CYAN" "$RST" "$BOLD" "$*" "$RST" >&2
    "$@"
}

# Ask before an op. With --grant: yes. Without a TTY and no --grant: no.
confirm() {
    (( GRANT )) && return 0
    [[ -t 0 ]] || return 1
    printf '%s[?]%s %s [y/N] ' "$YELLOW" "$RST" "$*"
    local ans; read -r ans
    [[ "$ans" =~ ^[yYsS] ]]
}

