# --- Args ---
POSARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--verbose)    VERBOSE=1; shift ;;
        -P|--parallel)   MODE="par"; shift ;;
        -S|--sequential) MODE="seq"; shift ;;
        -j|--jobs)       [[ $# -ge 2 ]] || { err "-j needs a number"; exit 1; }; JOBS="$2"; MODE="par"; shift 2 ;;
        -r|--resume)     RESUME=1; shift ;;
        -g|--grant)      GRANT=1; shift ;;
        -H|--hosts)      HOSTS=1; shift ;;
        -f|--file)       [[ $# -ge 2 ]] || { err "-f needs a file"; exit 1; }; TARGETFILE="$2"; shift 2 ;;
        -h|--help)       awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; exit 0 ;;
        --) shift; while [[ $# -gt 0 ]]; do POSARGS+=("$1"); shift; done ;;
        -*) err "Unknown option: $1"; exit 1 ;;
        *)  POSARGS+=("$1"); shift ;;
    esac
done
set -- ${POSARGS[@]+"${POSARGS[@]}"}

[[ "$JOBS" =~ ^[0-9]+$ ]] || { err "Invalid job count: $JOBS"; exit 1; }
command -v nmap >/dev/null 2>&1 || { err "nmap not found in PATH"; exit 1; }

banner

# Basic IPv4 validation.
validate_ip() {
    local ip="$1" o a b c d
    [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    IFS='.' read -r a b c d <<< "$ip"
    for o in "$a" "$b" "$c" "$d"; do (( o > 255 )) && return 1; done
    return 0
}

# --- Build target list: "IP|name" ---
TARGETS=()
if [[ -n "$TARGETFILE" ]]; then
    [[ -f "$TARGETFILE" ]] || { err "Target file not found: $TARGETFILE"; exit 1; }
    while read -r tip tname _; do
        [[ -z "$tip" || "$tip" == \#* ]] && continue
        validate_ip "$tip" || { warn "Invalid IP skipped: $tip"; continue; }
        [[ -z "$tname" ]] && tname="$tip"
        TARGETS+=("$tip|$tname")
    done < "$TARGETFILE"
    [[ ${#TARGETS[@]} -gt 0 ]] || { err "No valid targets in $TARGETFILE"; exit 1; }
    info "Targets: ${#TARGETS[@]}"
else
    if [[ $# -lt 1 || $# -gt 2 ]]; then
        err "Usage: $0 [-v] [-P|-S] [-j N] [-r] [-H] [-g] <IP> [name]"
        err "       $0 [opts] -f targets.txt"
        exit 1
    fi
    validate_ip "$1" || { err "Invalid IP: $1"; exit 1; }
    TARGETS+=("$1|${2:-$1}")   # name optional: dir = IP, real name found during scan
fi

# Parallel jobs the machine can take (cap 8: beyond that target rate-limiting
# starts dropping packets = missed ports).
detect_jobs() {
    local n=""
    if command -v nproc >/dev/null 2>&1; then n=$(nproc 2>/dev/null)
    elif command -v sysctl >/dev/null 2>&1; then n=$(sysctl -n hw.ncpu 2>/dev/null); fi
    [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 )) || n=4
    (( n > 8 )) && n=8
    printf '%s' "$n"
}

# A scan is "done" only if nmap wrote the "Nmap done" footer.
scan_complete() { grep -q '^# Nmap done' "$1" 2>/dev/null; }

# Resume (-r): skip if output exists and is already complete.
skip_if_done() {
    (( RESUME )) || return 1
    scan_complete "$1" || return 1
    ok "Resume: skip $2 (done)"
    return 0
}

# ============================================================
# /etc/hosts
# ============================================================

# Valid hostname: letters/digits/.-_ with at least one letter (excludes IPs).
valid_hostname() {
    [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$ ]] || return 1
    [[ "$1" =~ [A-Za-z] ]] || return 1
    return 0
}

# Names already mapped to an IP in /etc/hosts (one per line), ignoring comments.
hosts_names_for_ip() {
    grep -E "^[[:space:]]*${1//./\\.}[[:space:]]" /etc/hosts 2>/dev/null \
        | sed 's/#.*//' | awk '{$1=""; print}' | tr -s '[:space:]' '\n' | awk 'NF' | sort -u
}

# Add new/valid names for an IP to /etc/hosts: validates, dedups, adds only
# missing aliases (idempotent); asks unless --grant; sets TARGET if still the IP.
add_to_hosts() {
    local ip="$1"; shift
    local existing new=() n m seen
    existing=" $(hosts_names_for_ip "$ip" | tr '\n' ' ') "
    for n in "$@"; do
        n=$(printf '%s' "$n" | tr 'A-Z' 'a-z')
        valid_hostname "$n" || continue
        [[ "$n" == "$ip" ]] && continue
        [[ "$existing" == *" $n "* ]] && continue
        seen=0; for m in ${new[@]+"${new[@]}"}; do [[ "$m" == "$n" ]] && seen=1; done
        (( seen )) || new+=("$n")
    done
    [[ ${#new[@]} -eq 0 ]] && return 1

    confirm "Add to /etc/hosts: ${new[*]} ?" || return 1
    if printf '%s\t%s\n' "$ip" "${new[*]}" | run sudo tee -a /etc/hosts >/dev/null; then
        ok "/etc/hosts += ${new[*]}"
        [[ "$TARGET" == "$ip" ]] && TARGET="${new[0]}"
        return 0
    fi
    err "Cannot write /etc/hosts"
    return 1
}

# Extract candidate hostnames from nmap output (conservative: smb, ssl-cert,
# http redirects only) and drop noise like nmap.org from nmap's own footer.
extract_hostnames() {
    local f="$1"
    [[ -s "$f" ]] || return
    {
        grep -iE 'FQDN|DNS_Computer_Name|DNS_Domain_Name|Computer name|Domain name' "$f" | sed -E 's/.*:[[:space:]]*//'
        grep -oiE 'commonName=[A-Za-z0-9.*_-]+' "$f" | sed -E 's/commonName=//I'
        grep -oiE 'DNS:[A-Za-z0-9.*_-]+'        "$f" | sed -E 's/DNS://I'
        grep -oiE '(redirect to|resource was) https?://[A-Za-z0-9._-]+' "$f" | grep -oiE 'https?://[A-Za-z0-9._-]+' | sed -E 's#https?://##I'
    } 2>/dev/null \
        | sed -E 's/^\*\.//; s/^[.-]+//; s/[.,;]+$//' \
        | tr 'A-Z' 'a-z' \
        | grep -viE '(^|\.)(nmap|nmap\.org|example\.(com|org|net)|localhost|w3\.org)$' \
        | awk 'NF' | sort -u
}

# Reverse DNS + initial mapping (before the scan).
resolve_hostname() {
    local rev=""
    if command -v dig >/dev/null 2>&1; then
        rev=$(dig +short -x "$IP" 2>/dev/null | sed 's/\.$//' | head -n1)
    elif command -v host >/dev/null 2>&1; then
        rev=$(host "$IP" 2>/dev/null | awk '/pointer/ {sub(/\.$/,"",$NF); print $NF; exit}')
    elif command -v nslookup >/dev/null 2>&1; then
        rev=$(nslookup "$IP" 2>/dev/null | awk -F'= ' '/name =/ {sub(/\.$/,"",$2); print $2; exit}')
    fi
    [[ -n "$rev" ]] && info "Reverse DNS: $rev"

    local mapped
    mapped=$(hosts_names_for_ip "$IP" | paste -sd' ' -)
    if [[ -n "$mapped" ]]; then
        info "/etc/hosts: $mapped"
        [[ "$TARGET" == "$IP" ]] && TARGET="${mapped%% *}"
    fi

    local cand="$rev"
    [[ -z "$cand" && "$NAME" != "$IP" ]] && cand="$NAME"
    [[ -n "$cand" ]] && (( HOSTS )) && add_to_hosts "$IP" "$cand"
}

# Rename output dir to <name>-<discovered>, updating all paths. No-op if the
# name is already used or the destination exists.
rename_outdir() {
    local primary newdir
    primary=$(printf '%s' "$1" | tr -cd 'A-Za-z0-9._-')
    [[ -z "$primary" ]] && return
    [[ "$NAME" == *"$primary"* ]] && return
    newdir="${NAME}-${primary}"
    [[ "$newdir" == "$OUTDIR" || -e "$newdir" ]] && return
    confirm "Rename ${OUTDIR}/ -> ${newdir}/ ?" || return
    if mv "$OUTDIR" "$newdir" 2>/dev/null; then
        ok "Renamed: ${OUTDIR}/ -> ${newdir}/"
        OUTDIR="$newdir"; CHUNKDIR="$OUTDIR/.chunks"
        QUICK="$OUTDIR/quick.txt"; ALLPORTS="$OUTDIR/allports.txt"
        DEEP="$OUTDIR/deep.txt"; UDP="$OUTDIR/udp.txt"
        NEXT="$OUTDIR/next-steps.txt"; SUMMARY="$OUTDIR/summary.md"; CMDLOG="$OUTDIR/.commands"
    fi
}

# Hostnames discovered from services (after phase 2) -> rename dir + /etc/hosts.
discover_hostnames_post() {
    local names primary
    names=$(extract_hostnames "$DEEP")
    [[ -z "$names" ]] && return
    info "Hostnames: $(echo "$names" | paste -sd' ' -)"
    (( HOSTS )) || return     # -H to enable /etc/hosts edits + dir rename
    primary=$(echo "$names" | grep -v '\.' | head -n1)
    [[ -z "$primary" ]] && primary=$(echo "$names" | head -n1)
    rename_outdir "$primary"
    # shellcheck disable=SC2086
    add_to_hosts "$IP" $names
}

# ============================================================
# Reliable scans (retry until "Nmap done")
# ============================================================

# $3 set (sequential) = nmap output to screen; empty (parallel chunk) = silent.
scan_range_reliable() {
    local range="$1" out="$2" onscreen="${3:-}" t timing
    skip_if_done "$out" "range $range" && return 0
    for (( t=1; t<=MAX_TRIES; t++ )); do
        timing="-T4"; (( t > 1 )) && timing="-T3"
        log_cmd "sudo nmap -p$range -sS -Pn $timing --max-retries 6 -oN $out $IP"
        if [[ -n "$onscreen" ]]; then
            run sudo nmap -p"$range" -sS -Pn "$timing" --max-retries 6 -oN "$out" "$IP"
        else
            run sudo nmap -p"$range" -sS -Pn "$timing" --max-retries 6 -oN "$out" "$IP" >/dev/null 2>&1
        fi
        scan_complete "$out" && return 0
        warn "range $range incomplete (try $t/$MAX_TRIES)"
    done
    return 1
}

# Launch parallel chunks (no wait): fills CHUNK_PIDS/FILES/RANGES.
parallel_tcp_launch() {
    local jobs="$1"
    mkdir -p "$CHUNKDIR"
    (( RESUME )) || rm -f "$CHUNKDIR"/chunk_*.txt
    CHUNK_PIDS=(); CHUNK_FILES=(); CHUNK_RANGES=()
    local total=65535 start=1 i=0 per
    per=$(( (total + jobs - 1) / jobs ))
    info "TCP full scan — $jobs parallel chunks"
    while (( start <= total )); do
        local end=$(( start + per - 1 )); (( end > total )) && end=$total
        local cf; cf="$CHUNKDIR/chunk_$(printf '%02d' "$i").txt"
        scan_range_reliable "${start}-${end}" "$cf" &
        CHUNK_PIDS+=("$!"); CHUNK_FILES+=("$cf"); CHUNK_RANGES+=("${start}-${end}")
        start=$(( end + 1 )); i=$(( i + 1 ))
    done
}

# Wait chunks and merge only the confirmed ones.
parallel_tcp_collect() {
    : > "$ALLPORTS"
    local idx=0 pid
    for pid in "${CHUNK_PIDS[@]}"; do
        if wait "$pid"; then
            cat "${CHUNK_FILES[$idx]}" >> "$ALLPORTS"
        else
            err "range ${CHUNK_RANGES[$idx]} unconfirmed"
            UNVERIFIED+=("${CHUNK_RANGES[$idx]}"); INCOMPLETE=1
        fi
        idx=$(( idx + 1 ))
    done
}

# $1 set (sequential) = output to screen; empty (parallel) = silent.
udp_scan_reliable() {
    local onscreen="${1:-}" t
    skip_if_done "$UDP" "UDP" && return 0
    for (( t=1; t<=2; t++ )); do
        log_cmd "sudo nmap -sU -sV -sC -Pn --top-ports 100 -T3 --max-retries 4 -oN $UDP $IP"
        if [[ -n "$onscreen" ]]; then
            run sudo nmap -sU -sV -sC -Pn --top-ports 100 -T3 --max-retries 4 -oN "$UDP" "$IP"
        else
            run sudo nmap -sU -sV -sC -Pn --top-ports 100 -T3 --max-retries 4 -oN "$UDP" "$IP" >/dev/null 2>&1
        fi
        scan_complete "$UDP" && return 0
        warn "UDP incomplete (try $t/2)"
    done
    return 1
}

phase2_deep() {
    local ports="$1" t
    skip_if_done "$DEEP" "version/NSE" && return 0
    info "Version/NSE scan: $ports"
    for (( t=1; t<=2; t++ )); do
        log_cmd "sudo nmap -p$ports -sCV -Pn -T3 --max-retries 5 -oN $DEEP $IP"
        run sudo nmap -p"$ports" -sCV -Pn -T3 --max-retries 5 -oN "$DEEP" "$IP"
        scan_complete "$DEEP" && return 0
        warn "version/NSE incomplete (try $t/2)"
    done
    UNVERIFIED+=("version/NSE"); INCOMPLETE=1
    return 1
}

quick_scan() {
    local t qp
    skip_if_done "$QUICK" "quick" && return 0
    info "Quick scan (top 1000)"
    for (( t=1; t<=2; t++ )); do
        log_cmd "sudo nmap --top-ports 1000 -sS -Pn -T4 --max-retries 4 -oN $QUICK $IP"
        run sudo nmap --top-ports 1000 -sS -Pn -T4 --max-retries 4 -oN "$QUICK" "$IP"
        if scan_complete "$QUICK"; then
            qp=$(grep -hE '^[0-9]+/tcp[[:space:]]+open' "$QUICK" | cut -d/ -f1 | sort -n -u | paste -sd, -)
            [[ -n "$qp" ]] && ok "Quick: $qp" || info "Quick: none"
            return 0
        fi
        warn "quick incomplete (try $t/2)"
    done
    return 1
}

extract_ports() {
    grep -hE '^[0-9]+/tcp[[:space:]]+open' "$ALLPORTS" 2>/dev/null \
        | cut -d/ -f1 | sort -n -u | paste -sd, -
}

print_open_table() {
    printf '%s%s%s\n' "$YELLOW" "  PORT      STATE   SERVICE" "$RST"
    grep -hE '^[0-9]+/tcp[[:space:]]+open' "$ALLPORTS" | sort -n -u | sed 's/^/  /'
}

report_udp_ports() {
    local up
    up=$(grep -hE '^[0-9]+/udp[[:space:]]+(open|open\|filtered)' "$UDP" 2>/dev/null \
        | cut -d/ -f1 | sort -n -u | paste -sd, -)
    [[ -n "$up" ]] && ok "UDP: $up" || info "UDP: none"
}

# ============================================================
# Per-service enumeration hints (enumeration only — OSCP-safe)
# ============================================================
emit_suggestions() {
    local port="$1" svc="$2" ver="$3" t="$TARGET"
    printf '## %s/tcp — %s %s\n' "$port" "$svc" "$ver"
    case "$svc" in
        *ssl*http*|*https*|https)
            local url="https://$t:$port"
            printf '  whatweb %s\n  curl -sik %s/\n' "$url" "$url"
            printf '  feroxbuster -k -u %s -w /usr/share/seclists/Discovery/Web-Content/raft-medium-directories.txt\n' "$url"
            printf '  nikto -h %s\n  sslscan %s:%s\n' "$url" "$t" "$port" ;;
        *http*)
            local url="http://$t:$port"
            printf '  whatweb %s\n  curl -sik %s/robots.txt\n' "$url" "$url"
            printf '  feroxbuster -u %s -w /usr/share/seclists/Discovery/Web-Content/raft-medium-directories.txt\n' "$url"
            printf '  nikto -h %s\n' "$url"
            printf '  gobuster vhost -u %s --append-domain -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt\n' "$url" ;;
        ftp)
            printf '  ftp %s        # try anonymous/anonymous\n' "$t"
            printf '  nmap -p%s --script ftp-anon,ftp-syst %s\n' "$port" "$t" ;;
        ssh)
            printf '  ssh user@%s\n  nmap -p%s --script ssh2-enum-algos,ssh-auth-methods %s\n' "$t" "$port" "$t" ;;
        smtp|*smtp*)
            printf '  nmap -p%s --script smtp-commands,smtp-enum-users %s\n' "$port" "$t"
            printf '  smtp-user-enum -M VRFY -U users.txt -t %s\n' "$t" ;;
        domain|*dns*)
            printf '  dig axfr @%s <domain>\n  dnsenum %s\n' "$t" "$t" ;;
        *netbios*|*microsoft-ds*|*smb*)
            printf '  enum4linux-ng -A %s\n  smbclient -L //%s/ -N\n  smbmap -H %s\n' "$t" "$t" "$t"
            printf '  nmap -p%s --script smb-os-discovery,smb-enum-shares,smb-vuln-* %s\n' "$port" "$t" ;;
        *msrpc*)
            printf '  rpcclient -U "" -N %s\n' "$t" ;;
        *ldap*)
            printf '  ldapsearch -x -H ldap://%s -s base namingcontexts\n' "$t"
            printf '  nmap -p%s --script ldap-rootdse %s\n' "$port" "$t" ;;
        *kerberos*)
            printf '  kerbrute userenum -d <domain> --dc %s users.txt\n' "$t" ;;
        *ms-sql*|*mssql*)
            printf '  impacket-mssqlclient <user>@%s -windows-auth\n' "$t"
            printf '  nmap -p%s --script ms-sql-info,ms-sql-empty-password %s\n' "$port" "$t" ;;
        mysql|*mysql*)
            printf '  mysql -h %s -u root\n  nmap -p%s --script mysql-empty-password,mysql-info %s\n' "$t" "$port" "$t" ;;
        postgresql|*postgres*)
            printf '  psql -h %s -U postgres\n' "$t" ;;
        *ms-wbt*|*rdp*)
            printf '  xfreerdp /v:%s /u:user /p:pass +clipboard\n' "$t"
            printf '  nmap -p%s --script rdp-ntlm-info %s\n' "$port" "$t" ;;
        *vnc*)
            printf '  vncviewer %s:%s\n  nmap -p%s --script vnc-info,realvnc-auth-bypass %s\n' "$t" "$port" "$port" "$t" ;;
        *redis*)
            printf '  redis-cli -h %s\n' "$t" ;;
        *mongo*)
            printf '  mongosh --host %s --port %s\n' "$t" "$port" ;;
        *)
            case "$port" in
                5985|5986) printf '  evil-winrm -i %s -u user -p pass\n' "$t" ;;
                *) printf '  nmap -p%s -sCV --script "default,safe" %s\n' "$port" "$t" ;;
            esac ;;
    esac
    [[ -n "$ver" ]] && printf '  searchsploit %s\n' "$ver"
    echo
}

generate_next_steps() {
    local src="$DEEP"
    [[ -s "$src" ]] || src="$ALLPORTS"
    {
        printf '# next steps for %s (%s) — enumeration only\n\n' "$TARGET" "$IP"
        while read -r line; do
            local port svc ver
            port=$(printf '%s' "$line" | cut -d/ -f1)
            svc=$(printf '%s' "$line" | awk '{print $3}')
            ver=$(printf '%s' "$line" | awk '{$1=$2=$3=""; sub(/^ +/,""); print}')
            emit_suggestions "$port" "$svc" "$ver"
        done < <(grep -hE '^[0-9]+/tcp[[:space:]]+open' "$src" | sort -n -u)
    } > "$NEXT"
}

generate_summary() {
    {
        printf '# %s — %s\n\n' "$NAME" "$IP"
        [[ "$TARGET" != "$IP" ]] && printf '**Hostname:** %s\n\n' "$TARGET"
        printf '_%s · whatsthis_\n\n' "$(date '+%F %T')"

        printf '## Open TCP ports\n\n'
        local src="$DEEP"; [[ -s "$src" ]] || src="$ALLPORTS"
        if grep -qhE '^[0-9]+/tcp[[:space:]]+open' "$src" 2>/dev/null; then
            printf '| Port | State | Service | Version |\n|-----:|:-----:|---------|---------|\n'
            grep -hE '^[0-9]+/tcp[[:space:]]+open' "$src" | sort -n -u | awk '{
                port=$1; state=$2; svc=$3; $1=$2=$3=""; sub(/^ +/,"");
                printf "| %s | %s | %s | %s |\n", port, state, svc, $0 }'
        else
            printf '_No open TCP ports._\n'
        fi

        printf '\n## UDP ports (top 100)\n\n'
        if grep -qhE '^[0-9]+/udp[[:space:]]+(open|open\|filtered)' "$UDP" 2>/dev/null; then
            printf '| Port | State | Service |\n|-----:|:-----:|---------|\n'
            grep -hE '^[0-9]+/udp[[:space:]]+(open|open\|filtered)' "$UDP" | sort -n -u | awk '{
                printf "| %s | %s | %s |\n", $1, $2, $3 }'
        else
            printf '_No open UDP ports._\n'
        fi

        if [[ -s "$CMDLOG" ]]; then
            printf '\n## Commands run\n\n```bash\n'; cat "$CMDLOG"; printf '```\n'
        fi

        printf '\n## Files\n\n'
        printf -- '- `%s` — full TCP\n' "$ALLPORTS"
        [[ -s "$DEEP" ]] && printf -- '- `%s` — version + NSE\n' "$DEEP"
        printf -- '- `%s` — UDP top 100\n' "$UDP"
        printf -- '- `%s` — next steps\n' "$NEXT"
    } > "$SUMMARY"
}

# ============================================================
# Full scan of one target
# ============================================================
scan_target() {
    IP="$1"; NAME="$2"
    OUTDIR="$NAME"; CHUNKDIR="$OUTDIR/.chunks"
    QUICK="$OUTDIR/quick.txt"; ALLPORTS="$OUTDIR/allports.txt"
    DEEP="$OUTDIR/deep.txt"; UDP="$OUTDIR/udp.txt"
    NEXT="$OUTDIR/next-steps.txt"; SUMMARY="$OUTDIR/summary.md"; CMDLOG="$OUTDIR/.commands"
    TARGET="$IP"
    INCOMPLETE=0; UNVERIFIED=()
    mkdir -p "$OUTDIR"; : > "$CMDLOG"

    printf '\n%s%s=== %s -> %s/ ===%s\n' "$BOLD" "$BLUE" "$IP" "$OUTDIR" "$RST"
    resolve_hostname
    quick_scan

    local ports="" udp_pid
    if [[ "$MODE" == "par" ]]; then
        (( JOBS == 0 )) && JOBS=$(detect_jobs)
        ok "Parallel mode ($JOBS jobs)"
        info "UDP scan (top 100)"
        udp_scan_reliable "" &
        udp_pid="$!"
        parallel_tcp_launch "$JOBS"
        parallel_tcp_collect
        ports=$(extract_ports)
        if [[ -z "$ports" ]]; then
            warn "No open TCP ports"
        else
            ok "TCP: $ports"; print_open_table; phase2_deep "$ports"
        fi
        kill -0 "$udp_pid" 2>/dev/null && info "TCP done — finishing UDP..."
        wait "$udp_pid" && report_udp_ports || { err "UDP unconfirmed"; UNVERIFIED+=("UDP"); INCOMPLETE=1; }
    else
        info "TCP full scan (all 65535 ports)"
        scan_range_reliable "1-65535" "$ALLPORTS" screen || { err "full TCP unconfirmed"; UNVERIFIED+=("1-65535"); INCOMPLETE=1; }
        ports=$(extract_ports)
        if [[ -z "$ports" ]]; then
            warn "No open TCP ports"
        else
            ok "TCP: $ports"; print_open_table; phase2_deep "$ports"
        fi
        info "UDP scan (top 100)"
        udp_scan_reliable screen && report_udp_ports || { err "UDP unconfirmed"; UNVERIFIED+=("UDP"); INCOMPLETE=1; }
    fi

    [[ -n "$ports" && -s "$DEEP" ]] && discover_hostnames_post

    [[ -n "$ports" ]] && generate_next_steps
    generate_summary
    ok "Output: $OUTDIR/ (summary.md, next-steps.txt)"

    if (( INCOMPLETE )); then
        err "[$IP] incomplete — possible missed ports:"
        for u in "${UNVERIFIED[@]}"; do err "  - $u"; done
        OVERALL_FAIL=1
        return 1
    fi
    ok "[$IP] done"
    return 0
}

# ============================================================
# Run
# ============================================================
# One sudo prompt up front, then keep the timestamp warm so long unattended
# (background) runs don't re-prompt mid-scan.
run sudo -v || { err "sudo required for SYN/UDP scans"; exit 1; }
( while true; do sudo -n true 2>/dev/null; sleep 50; kill -0 "$$" 2>/dev/null || exit; done ) &
SUDO_KEEPALIVE=$!
trap 'kill "$SUDO_KEEPALIVE" 2>/dev/null' EXIT

for entry in "${TARGETS[@]}"; do
    scan_target "${entry%%|*}" "${entry#*|}"
done

echo
if (( OVERALL_FAIL )); then
    err "Some scans incomplete — see above (retry with -S or -r)"
    exit 2
fi
ok "Done: ${#TARGETS[@]} target(s)"
