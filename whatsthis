#!/usr/bin/env bash
#
# whatsthis — Workflow di scansione in 3 fasi
# Autore: Giva (github.com/Givaa)
#   Fase 1: full TCP SYN scan (-p- -sS) su tutte le 65535 porte
#   Fase 2: version detection + NSE default (-sCV) SOLO sulle porte aperte
#   Fase 3: UDP top 100 (-sU -sV)
#
# Modalità:
#   sequenziale (default) — un solo stream, timing conservativo.
#   parallela  (-P)       — porte divise in blocchi concorrenti + UDP in
#                           parallelo al TCP. Job auto-rilevati dai core
#                           (cap 8) o forzati con -j N.
#
# /etc/hosts:
#   * pre-scan: reverse DNS + mappatura opzionale
#   * post-scan: estrae gli hostname dai servizi (smb/ssl-cert/http/ldap/PTR)
#     e propone di aggiungerli (gestisce alias multipli e dedup, idempotente)
#
# Garanzie anti-perdita (entrambe le modalità):
#   * -Pn          : un host che blocca il ping NON viene saltato.
#   * auto-verifica: ogni scansione è valida solo se nmap segnala "Nmap done";
#                    altrimenti viene ritentata (timing più conservativo).
#   * niente merge silenzioso di dati parziali: i range non confermati sono
#                    elencati e lo script esce con codice != 0.
#
# Opzioni:
#   -P/-S        modalità parallela / sequenziale (default: sequenziale)
#   -j N         numero di job in parallelo (implica -P; 0 = auto)
#   -r           resume: salta le scansioni già completate (Nmap done)
#   -f FILE      multitarget: una riga per host, "IP [nome]" (# = commento)
#   -v           verbose: stampa i comandi lanciati
#
# Uso: ./whatsthis [-v] [-P|-S] [-j N] [-r] <IP> <nome>
#      ./whatsthis [opzioni] -f targets.txt
# Es.: ./whatsthis 10.10.10.5 box01            # singolo, sequenziale
#      ./whatsthis -P 10.10.10.5 box01         # parallelo (auto-job)
#      ./whatsthis -P -r -f targets.txt        # multitarget, parallelo, resume
#
# Output: tutto dentro la cartella ./<nome>/
#   quick.txt      — quick-win top 1000 (foothold immediato)
#   allports.txt   — full TCP
#   deep.txt       — version detection + NSE
#   udp.txt        — UDP top 100
#   next-steps.txt — comandi di enumerazione suggeriti per servizio
#   summary.md     — report Markdown (riusabile nel report OSCP)
#
set -uo pipefail

# --- Colori ---
RED=$'\e[31m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; BLUE=$'\e[34m'; CYAN=$'\e[36m'; BOLD=$'\e[1m'; RST=$'\e[0m'

err()  { printf '%s[!]%s %s\n' "$RED"   "$RST" "$*" >&2; }
info() { printf '%s[*]%s %s\n' "$BLUE"  "$RST" "$*"; }
ok()   { printf '%s[+]%s %s\n' "$GREEN" "$RST" "$*"; }
warn() { printf '%s[!]%s %s\n' "$YELLOW" "$RST" "$*" >&2; }

VERBOSE=0
MODE="seq"        # seq | par
JOBS=0            # 0 = auto
RESUME=0          # 1 = salta le scansioni già completate (Nmap done)
TARGETFILE=""     # file con lista target (-f)
INCOMPLETE=0      # diventa 1 se un range non viene confermato (per-target)
UNVERIFIED=()     # range/scansioni non confermate (per-target)
OVERALL_FAIL=0    # 1 se almeno un target è incompleto
MAX_TRIES=3

# Esegue un comando in foreground; in verbose lo stampa prima.
run() {
    if (( VERBOSE )); then
        printf '%s[>]%s %s%s%s\n' "$CYAN" "$RST" "$BOLD" "$*" "$RST" >&2
    fi
    "$@"
}

